# Optional backend demo session, used only when a caller sends no session of
# their own (via the x-li-at / x-jsessionid headers). Leave unset to require
# every caller to bring their own session. Never commit real values.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Kill switch: set to false to stop all live LinkedIn traffic immediately and
# serve cache-only.
ALLOW_LIVE=true

# Hard ceiling on live fetches per day, across all callers.
DAILY_QUOTA=50

# Jittered delay bounds (seconds) between live requests.
MIN_DELAY=0.8
MAX_DELAY=2.5

CACHE_DIR=fixtures/cache

# Optional: shared daily-quota counter via Upstash Redis's REST API (free
# tier, no server to run - https://upstash.com, create a Redis database,
# copy "UPSTASH_REDIS_REST_URL" and "UPSTASH_REDIS_REST_TOKEN" from its
# dashboard). When set, local runs and the deployed server draw down the
# same daily quota against the same LinkedIn account. When unset, each
# process just counts its own live fetches in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
