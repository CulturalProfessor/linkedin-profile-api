# Optional backend demo session, used only when a caller sends no session of
# their own (via x-li-cookie, or x-li-at/x-jsessionid). Leave unset to
# require every caller to bring their own session. Never commit real values.

# Recommended: the full Cookie header value from a real linkedin.com request
# (DevTools -> Network -> Copy as cURL), base64-encoded. tools/curl_to_env.py
# prints this ready to paste. Base64 because a raw cookie string can contain
# quotes/#/spaces that collide with .env's own quoting rules depending on how
# it's pasted in - base64 only ever produces [A-Za-z0-9+/=], so this can never
# misparse. Takes priority over everything else below when set.
LINKEDIN_FULL_COOKIE_B64=

# Plain (unencoded) alternative to the above, used only if it's unset. If you
# use this one instead, wrap the whole value in single quotes yourself, e.g.
# LINKEDIN_FULL_COOKIE='li_at=...; JSESSIONID="..."; bcookie="..."'
LINKEDIN_FULL_COOKIE=

# Minimal alternative to both of the above, used only when neither is set.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Shared secret callers must send as `x-api-key` on /profile. Only enforced
# when a backend session (above) is configured AND the caller sends no session
# of their own - a caller bringing their own x-li-cookie spends their own
# account's quota, so there is nothing to protect. Leave blank locally; set it
# before exposing a deployment that carries your cookie, or anyone with the URL
# can scrape LinkedIn as you.
API_KEY=

# Kill switch: set to false to stop all live LinkedIn traffic immediately and
# serve cache-only.
ALLOW_LIVE=true

# Hard ceiling on live fetches per day, across all callers.
DAILY_QUOTA=150

# Jittered delay bounds (seconds) between live requests.
MIN_DELAY=0.5
MAX_DELAY=1.5

CACHE_DIR=.cache

# Where cached profiles live: auto (default) | disk | upstash.
# "auto" uses Upstash when UPSTASH_REDIS_REST_* are set and falls back to disk.
# Prefer Upstash for any real deployment: Render's free tier replaces the
# container on every deploy and after ~15 minutes idle, taking a disk cache
# with it, so entries rarely survive long enough for the 24h TTL or the
# stale-serving paths to mean anything.
CACHE_BACKEND=auto

# Optional: shared daily-quota counter via Upstash Redis's REST API (free
# tier, no server to run - https://upstash.com, create a Redis database,
# copy "UPSTASH_REDIS_REST_URL" and "UPSTASH_REDIS_REST_TOKEN" from its
# dashboard). When set, local runs and the deployed server draw down the
# same daily quota against the same LinkedIn account. When unset, each
# process just counts its own live fetches in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser fingerprint headers (user-agent, sec-ch-ua*, accept-language) captured
# from the same request as the cookie, base64-encoded JSON. Written automatically
# by tools/curl_to_env.py. Replaying the identity that actually established the
# session beats guessing at one - an invented fingerprint that contradicts itself
# is a louder anomaly signal than sending none. Leave unset to use the generic
# defaults in app/voyager_client.py.
LINKEDIN_BROWSER_HEADERS_B64=
